{
  "name": "telechat-desktop",
  "version": "1.4.3",
  "description": "Официальное Windows-приложение ExstraChat",
  "main": "main.js",
  "author": "creator",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "chat.tele.desktop",
    "productName": "ExstraChat",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "update-model.js",
      "update-helper.ps1",
      "browser/**",
      "package.json",
      "assets/icon.png"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "ExstraChat-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ExstraChat"
    },
    "portable": {
      "artifactName": "ExstraChat-Portable-${version}.${ext}"
    }
  }
}
